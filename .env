DATABASE_URL="postgresql://doorkey:doorkey@localhost:5432/doorkey?schema=public"
# openssl rand -base64 32
AUTH_SECRET="doorkey-local-dev-secret-7f82a91c4e5d6b3a"
APP_URL="http://localhost:3000"

# ---- optional: Google sign-in (falls back to email/password if unset) ---
